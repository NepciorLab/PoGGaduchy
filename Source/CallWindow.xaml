<Window x:Class="PoGGaduchy.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Icon="Assets/app.ico" Title="PoGGaduchy – rozmowa"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" Background="#0B1B2B" FontFamily="Segoe UI">
    <Grid>
        <wv2:WebView2 x:Name="Web" Visibility="Hidden"/>

        <!-- Gdy nie da się uruchomić strony rozmowy (np. brak składnika WebView2) -->
        <Grid x:Name="ErrorPanel" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="1000">
                <TextBlock x:Name="ErrorTitle" Text="Nie udało się uruchomić rozmowy" Foreground="#FFC857" FontSize="64" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="ErrorText" Foreground="White" FontSize="34" TextAlignment="Center" TextWrapping="Wrap" Margin="0,24,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource RoundButton}" Width="200" Height="200" Background="#D62828" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,60,50" Click="OnErrorHangup" AutomationProperties.Name="Rozłącz">
                <Path Data="M12 9c-1.6 0-3.15.25-4.6.72v3.1c0 .39-.23.74-.56.9-.98.49-1.87 1.12-2.66 1.85-.18.18-.43.28-.71.28-.28 0-.53-.11-.71-.29L.29 13.08c-.18-.17-.29-.42-.29-.7 0-.28.11-.53.29-.71C3.34 8.78 7.46 7 12 7s8.66 1.78 11.71 4.67c.18.18.29.43.29.71 0 .28-.11.53-.29.71l-2.48 2.48c-.18.18-.43.29-.71.29-.27 0-.52-.11-.7-.28-.79-.74-1.69-1.36-2.67-1.85-.33-.16-.56-.5-.56-.9v-3.1C15.15 9.25 13.6 9 12 9z" Fill="White" Stretch="Uniform" Width="125" Height="100"/>
            </Button>
        </Grid>
    </Grid>
</Window>
