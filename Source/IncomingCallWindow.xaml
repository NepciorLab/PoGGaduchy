<Window x:Class="PoGGaduchy.IncomingCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico" Title="PoGGaduchy – dzwoni"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        FontFamily="Segoe UI" PreviewKeyDown="OnKey">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#16385B" Offset="0"/>
            <GradientStop Color="#2C6A9E" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <!-- Cała zawartość ma stały rozmiar projektowy i skaluje się do okna -->
    <Viewbox Stretch="Uniform" Margin="30">
        <StackPanel Width="1700" Height="1000">
            <TextBlock x:Name="Caption" Text="Dzwoni do Ciebie" Foreground="#FFD27A" FontSize="64" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,24"/>
            <Border Width="400" Height="400" CornerRadius="50" Background="#4C7FB0" BorderBrush="White" BorderThickness="9" HorizontalAlignment="Center">
                <Grid>
                    <Border CornerRadius="40">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Image}" Viewbox="{Binding Crop}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="Initial" Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="190"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <TextBlock x:Name="NameText" Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="96" TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="40,22,40,0"/>
            <TextBlock x:Name="KindText" Foreground="#E6F0FA" FontSize="44" TextAlignment="Center" Margin="0,6,0,0"/>
            <TextBlock x:Name="NoCameraText" Text="Ten komputer nie ma kamery – rozmowa będzie bez Twojego obrazu." Foreground="#FFD27A" FontSize="36"
                       TextAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,36,0,0">
                <Button x:Name="AnswerButton" Style="{StaticResource BigButton}" Width="720" Height="230" Background="#2EA043" Click="OnAnswer" AutomationProperties.Name="Odbierz">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AnswerIcon" FontFamily="{StaticResource IconFont}" Text="&#xE717;" FontSize="110" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="Odbierz" FontSize="100" FontWeight="Bold" Foreground="White" Margin="30,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DeclineButton" Style="{StaticResource BigButton}" Width="720" Height="230" Background="#D62828" Margin="60,0,0,0" Click="OnDecline" AutomationProperties.Name="Odrzuć">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12 9c-1.6 0-3.15.25-4.6.72v3.1c0 .39-.23.74-.56.9-.98.49-1.87 1.12-2.66 1.85-.18.18-.43.28-.71.28-.28 0-.53-.11-.71-.29L.29 13.08c-.18-.17-.29-.42-.29-.7 0-.28.11-.53.29-.71C3.34 8.78 7.46 7 12 7s8.66 1.78 11.71 4.67c.18.18.29.43.29.71 0 .28-.11.53-.29.71l-2.48 2.48c-.18.18-.43.29-.71.29-.27 0-.52-.11-.7-.28-.79-.74-1.69-1.36-2.67-1.85-.33-.16-.56-.5-.56-.9v-3.1C15.15 9.25 13.6 9 12 9z" Fill="White" Stretch="Uniform" Width="138" Height="110" VerticalAlignment="Center"/>
                        <TextBlock Text="Odrzuć" FontSize="100" FontWeight="Bold" Foreground="White" Margin="30,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Viewbox>
</Window>
