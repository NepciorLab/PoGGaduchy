<Window x:Class="PoGGaduchy.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico" Title="PoGGaduchy" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="22" Background="#F1F5F9">
    <StackPanel Margin="28" Width="560">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBox x:Name="Box" FontSize="26" Padding="8,6" MaxLength="60"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Anuluj" Padding="26,10" Margin="0,0,14,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Dodaj" Padding="40,10" FontWeight="Bold" Background="#2EA043" Foreground="White" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
