<Window x:Class="PoGGaduchy.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PoGGaduchy"
        Icon="Assets/app.ico" Title="PoGGaduchy – załóż konto" WindowState="Maximized" MinWidth="640" MinHeight="420"
        FontFamily="Segoe UI">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#16385B" Offset="0"/>
            <GradientStop Color="#2C6A9E" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <!-- Cała zawartość ma stały rozmiar projektowy i skaluje się do okna -->
        <Viewbox Stretch="Uniform" Margin="30">
            <Grid Width="1700" Height="980">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1030"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Witaj w PoGGaduchach!" Foreground="White" FontSize="84" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="Aby rozmawiać z rodziną, załóż swoje konto. To zajmie chwilę." Foreground="#E6F0FA" FontSize="40" TextWrapping="Wrap" Margin="0,10,0,34"/>

                    <TextBlock Text="Jak masz na imię? (tak zobaczą Cię inni)" Foreground="#FFD27A" FontSize="38" FontWeight="SemiBold"/>
                    <TextBox x:Name="NameBox" FontSize="60" Padding="16,10" MaxLength="40" Margin="0,10,0,0" TextChanged="OnNameChanged"
                             AutomationProperties.Name="Twoje imię"/>

                    <Button x:Name="CreateButton" Style="{StaticResource BigButton}" Click="OnCreate" Background="#2EA043" Height="170" Margin="0,40,0,0"
                            AutomationProperties.Name="Utwórz konto">
                        <TextBlock Text="Utwórz konto" FontSize="72" FontWeight="Bold" Foreground="White"/>
                    </Button>
                    <TextBlock x:Name="StatusText" Foreground="#FFD27A" FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,24,0,0"/>
                    <TextBlock Foreground="#E6F0FA" FontSize="30" TextWrapping="Wrap" Margin="0,24,0,0"
                               Text="Administrator musi zaakceptować Twoje konto. Do tego czasu możesz rozmawiać tylko z nim."/>
                </StackPanel>

                <Border Grid.Column="2" Background="White" CornerRadius="30" Padding="28" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Twoje zdjęcie (nieobowiązkowe)" FontSize="30" FontWeight="Bold" Foreground="#16385B" Margin="0,0,0,14"/>
                        <local:PhotoEditor x:Name="Photo" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Viewbox>

        <!-- Wyłączenie programu -->
        <Button Style="{StaticResource SquareButton}" Click="OnExit" AutomationProperties.Name="Wyłącz program"
                Width="128" Height="128" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,28,0"
                Background="#D62828" Focusable="False">
            <Path Data="M 0,0 L 24,24 M 24,0 L 0,24" Stroke="White" StrokeThickness="14" Stretch="Fill" Width="64" Height="64"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Button>
    </Grid>
</Window>
