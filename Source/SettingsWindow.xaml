<Window x:Class="PoGGaduchy.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PoGGaduchy"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Icon="Assets/app.ico"
        Title="Ustawienia" Width="1320" Height="920" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="20" Background="#F1F5F9">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#16385B"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,16"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="12" Background="#EEF3F8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DDE8F3"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16385B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Grupy ustawień -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0">
            <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavItem}"
                     SelectionChanged="OnNavChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBoxItem Tag="image" Content="Mój obraz" AutomationProperties.Name="Mój obraz"/>
                <ListBoxItem Tag="av" Content="Audio i wideo" AutomationProperties.Name="Audio i wideo"/>
                <ListBoxItem Tag="calls" Content="Połączenia" AutomationProperties.Name="Połączenia"/>
                <ListBoxItem Tag="look" Content="Wygląd" AutomationProperties.Name="Wygląd"/>
                <ListBoxItem x:Name="NavPeople" Tag="people" Content="Osoby (administrator)" AutomationProperties.Name="Osoby (administrator)" Visibility="Collapsed"/>
                <ListBoxItem Tag="program" Content="Program" AutomationProperties.Name="Program"/>
            </ListBox>
        </Border>

        <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Mój obraz -->
                <Border x:Name="PanelImage" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Mój obraz" Style="{StaticResource SectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14"
                                   Text="To zdjęcie zobaczą wszystkie osoby: na swoich kafelkach i gdy do nich zadzwonisz. Każdy może zmienić tylko własny obraz."/>
                        <local:PhotoEditor x:Name="MyPhoto" HorizontalAlignment="Left"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="SaveMyImage" Content="Zapisz i pokaż wszystkim" Style="{StaticResource ActionButton}" Background="#2EA043" Foreground="White" FontWeight="Bold" Click="OnSaveMyImage"/>
                            <Button Content="Usuń mój obraz" Style="{StaticResource ActionButton}" Click="OnRemoveMyImage"/>
                        </WrapPanel>
                        <TextBlock x:Name="MyImageStatus" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Audio i wideo -->
                <Border x:Name="PanelAv" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Audio i wideo" Style="{StaticResource SectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14"
                                   Text="Wybierz mikrofon, głośniki i kamerę używane w rozmowach. „Domyślne” oznacza urządzenia wybrane w Windows. Zmiana działa od razu, także w trwającej rozmowie."/>
                        <TextBlock Text="Mikrofon" Margin="0,0,0,4"/>
                        <ComboBox x:Name="MicBox" SelectionChanged="OnDeviceChanged" AutomationProperties.Name="Mikrofon"/>
                        <TextBlock Text="Głośniki" Margin="0,0,0,4"/>
                        <ComboBox x:Name="SpeakerBox" SelectionChanged="OnDeviceChanged" AutomationProperties.Name="Głośniki"/>
                        <TextBlock Text="Kamera" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CameraBox" SelectionChanged="OnDeviceChanged" AutomationProperties.Name="Kamera"/>
                        <WrapPanel>
                            <Button Content="Sprawdź głośniki" Style="{StaticResource ActionButton}" Click="OnTestSpeakers"/>
                            <Button Content="Odśwież podgląd" Style="{StaticResource ActionButton}" Click="OnRefreshPreview"/>
                        </WrapPanel>
                        <TextBlock x:Name="DeviceStatus" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Podgląd kamery i poziom mikrofonu (zielony pasek pod obrazem rusza się, gdy mówisz):" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Border Width="560" Height="340" HorizontalAlignment="Left" BorderBrush="#C5D3E0" BorderThickness="2" Background="#0B1B2B">
                            <wv2:WebView2 x:Name="DeviceView" Visibility="Hidden"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Połączenia -->
                <Border x:Name="PanelCalls" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Połączenia" Style="{StaticResource SectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14"
                                   Text="Odbieraj rozmowy automatycznie od zaufanych osób (bez naciskania „Odbierz”):"/>
                        <ItemsControl x:Name="AutoAnswerList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding AutoAnswer}" Content="{Binding Name}" FontSize="22" Margin="0,0,0,12"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoPeopleText" Text="Lista osób pojawi się po połączeniu z serwerem." Foreground="#555" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Wygląd -->
                <Border x:Name="PanelLook" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Wygląd kafelków" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Szerokość kafelka" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="260" Maximum="1000" SmallChange="10" LargeChange="50" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding TileWidth}" Margin="0,8"/>
                            <TextBlock Grid.Column="2" Text="{Binding TileWidth, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="Wysokość kafelka" VerticalAlignment="Center"/>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="80" Maximum="320" SmallChange="5" LargeChange="20" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding TileHeight}" Margin="0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TileHeight, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="Wielkość czcionki nazw" VerticalAlignment="Center"/>
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="14" Maximum="90" SmallChange="1" LargeChange="6" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding NameFontSize}" Margin="0,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding NameFontSize, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Podgląd:" FontWeight="SemiBold" Margin="0,14,0,6"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ContentControl x:Name="Preview" ContentTemplate="{StaticResource ContactTile}" HorizontalAlignment="Left"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Osoby (administrator) -->
                <Border x:Name="PanelPeople" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Osoby (administrator)" Style="{StaticResource SectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14"
                                   Text="Tylko administrator widzi tę listę. Może dodawać i usuwać osoby, zmieniać nazwy i ustawiać obraz każdej z nich."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ListBox x:Name="PeopleList" Height="420" BorderThickness="1" SelectionChanged="OnPersonChanged" AutomationProperties.Name="Lista osób">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2,4">
                                                <Border Width="48" Height="48" CornerRadius="9" Background="#4C7FB0">
                                                    <Grid>
                                                        <Border CornerRadius="9"><Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/></Border.Background></Border>
                                                        <TextBlock x:Name="Init" Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="22" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Image}" Value="{x:Null}"><Setter TargetName="Init" Property="Visibility" Value="Visible"/></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="+ Dodaj osobę…" Style="{StaticResource ActionButton}" Click="OnAddPerson"/>
                                    <Button Content="Usuń osobę" Style="{StaticResource ActionButton}" Click="OnRemovePerson"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel x:Name="PersonEdit" Grid.Column="2">
                                <TextBlock Text="Nazwa osoby (widoczna u wszystkich)" Margin="0,0,0,4"/>
                                <TextBox x:Name="PersonNameBox" AutomationProperties.Name="Nazwa osoby"/>
                                <WrapPanel Margin="0,10,0,14">
                                    <Button Content="Zapisz nazwę" Style="{StaticResource ActionButton}" Click="OnSavePersonName"/>
                                    <Button Content="Nowy kod instalacji…" Style="{StaticResource ActionButton}" Click="OnNewCode"/>
                                </WrapPanel>
                                <local:PhotoEditor x:Name="PersonPhoto" HorizontalAlignment="Left"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Zapisz obraz tej osoby" Style="{StaticResource ActionButton}" Background="#2EA043" Foreground="White" FontWeight="Bold" Click="OnSavePersonImage"/>
                                    <Button Content="Usuń obraz tej osoby" Style="{StaticResource ActionButton}" Click="OnRemovePersonImage"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="PeopleStatus" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Program -->
                <StackPanel x:Name="PanelProgram" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ten program" Style="{StaticResource SectionTitle}"/>
                            <CheckBox IsChecked="{Binding Autostart}">
                                <TextBlock Text="Uruchamiaj program razem z Windows" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock x:Name="IdentityText" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <TextBlock x:Name="AdminText" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold"/>
                            <TextBlock Text="Kod instalacji (wklej tutaj, jeśli program go jeszcze nie ma lub trzeba go zmienić):" TextWrapping="Wrap" FontSize="16" Foreground="#555"/>
                            <TextBox x:Name="CodeBox" FontSize="16" Margin="0,4,0,8"/>
                            <Button Content="Zapisz kod instalacji" Style="{StaticResource ActionButton}" Click="OnSaveCode" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="CodeStatus" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Aktualizacje programu" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="VersionText" Margin="0,0,0,8"/>
                            <CheckBox x:Name="AutoUpdateBox" IsChecked="{Binding AutoUpdate}">
                                <TextBlock Text="Sprawdzaj i pobieraj aktualizacje automatycznie (z GitHuba)" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding SilentUpdate}" Margin="30,0,0,12">
                                <TextBlock Text="Cicha aktualizacja: instaluj pobraną wersję bez pytania (gdy nikt nie korzysta z programu albo przy uruchomieniu)" TextWrapping="Wrap"/>
                            </CheckBox>
                            <WrapPanel>
                                <Button x:Name="CheckUpdateButton" Content="Sprawdź teraz" Style="{StaticResource ActionButton}" Click="OnCheckUpdate"/>
                                <Button x:Name="InstallUpdateButton" Content="Zainstaluj i uruchom ponownie" Style="{StaticResource ActionButton}"
                                        Click="OnInstallUpdate" Visibility="Collapsed"/>
                            </WrapPanel>
                            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Gdzie są zapisane ustawienia" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="DataPath" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button Content="Otwórz ten folder" Style="{StaticResource ActionButton}" Click="OnOpenDataFolder" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Dół -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0">
            <Button Content="Zamknij program" HorizontalAlignment="Left" Padding="22,12" FontSize="22" Click="OnQuit"/>
            <Button Content="Gotowe" HorizontalAlignment="Right" Padding="60,12" FontSize="26" FontWeight="Bold"
                    Background="#2EA043" Foreground="White" IsDefault="True" Click="OnDone"/>
        </Grid>
    </Grid>
</Window>
